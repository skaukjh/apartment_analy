# ------------------------------------------------------------------
# 부동산 갈아타기 대시보드 환경변수
# .env.local 로 복사한 뒤 값을 채우세요. Vercel 배포 시에는 프로젝트 환경변수에 동일하게 등록합니다.
# 키가 없는 소스는 해당 대시보드 섹션만 비활성화되고 앱은 정상 동작합니다.
# ------------------------------------------------------------------

# [필수] 국토교통부 아파트 매매 실거래가 — 시세·갭·확산지도·신고가 분석의 근간
# 신청: https://www.data.go.kr/data/15126469/openapi.do  (일반 인증키 Decoding 값 사용)
DATA_GO_KR_SERVICE_KEY=

# [권장] 한국은행 ECOS — 기준금리 / 소비자물가 / M2 / 주택담보대출금리
# 신청: https://ecos.bok.or.kr/api/#/AuthKeyApply
ECOS_API_KEY=
# 통계표·항목 코드는 ECOS 개편 시 바뀔 수 있어 필요할 때만 덮어씁니다
# ECOS_STAT_BASE_RATE=722Y001
# ECOS_ITEM_BASE_RATE=0101000
# ECOS_STAT_CPI=901Y009
# ECOS_ITEM_CPI=0
# ECOS_STAT_M2=101Y004
# ECOS_ITEM_M2=BBHA00
# ECOS_STAT_MORTGAGE=121Y006
# ECOS_ITEM_MORTGAGE=BECBLA03

# [선택] 한국부동산원 R-ONE — 주간 매매가격지수 / 매매수급동향
# 없으면 실거래 기반 대리지표로 자동 대체됩니다.
# 신청: https://www.reb.or.kr/r-one/portal/openapi/openApiIntro.do
REB_API_KEY=
# REB_STATBL_WEEKLY_PRICE=
# REB_STATBL_SUPPLY_DEMAND=

# [권장] 네이버 검색 API — 뉴스 + 공식 발표 표적 수집 + 블로그·카페(참고용)
# 신청: https://developers.naver.com/apps/#/register  (검색 API 추가)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# [선택] 정부 부처 보도자료 RSS 직접 구독
# 정부 사이트 RSS 는 개편으로 주소가 자주 바뀌어 기본값을 두지 않았습니다.
# 형식: "부처명|URL" 을 쉼표로 구분
# 예: GOV_RSS_FEEDS=국토교통부|https://www.molit.go.kr/…/rss.xml,금융위원회|https://www.fsc.go.kr/…/rss
GOV_RSS_FEEDS=

# [선택] 금융감독원 금융상품통합비교공시 — 은행별 주담대 공시금리 (은행명 + 최저·최고 금리)
# 신청: https://finlife.fss.or.kr/finlife/api/fnprdInfo/list
FSS_API_KEY=

# [선택] 통계청 KOSIS — 수도권 인구 순이동 (주택 수요 장기 선행 지표)
# 신청: https://kosis.kr/openapi
KOSIS_API_KEY=
# 통계표 개편 시 전체 URL 을 직접 지정
# KOSIS_URL_NET_MIGRATION=

# [선택] OpenAI — 매물 종합 평가 및 챗봇
# 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# 기본 gpt-4.1-mini. 더 정교한 분석이 필요하면 gpt-4.1 등으로 변경
OPENAI_MODEL=

# [선택] 주택담보대출 총액 한도 (원). 정책 변경 시 조정 — 기본 6억
# NEXT_PUBLIC_MORTGAGE_CAP=600000000

# [필수] Supabase — 설정 저장, 실거래 캐시, 카카오 토큰 보관
# 없으면 서버 메모리만 사용해 재시작 시 초기화되고 자동 브리핑을 쓸 수 없습니다.
# supabase/migrations/0001_init.sql 을 SQL Editor 에 실행하세요.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# [필수] 카카오 — 브리핑 "나에게 보내기" + 카카오맵 로컬 API(주변 역·학교·마트)
# https://developers.kakao.com → 앱 생성 → REST API 키
# 카카오 로그인 활성화 + Redirect URI 등록 + 동의항목 talk_message 활성화
# 주변 입지 정보를 쓰려면 [카카오맵] 도 함께 활성화하세요 (같은 키 사용).
KAKAO_REST_API_KEY=
# 보안(Client Secret)을 사용하도록 설정했다면 입력
KAKAO_CLIENT_SECRET=
# 비우면 요청 origin + /api/kakao/callback 을 자동 사용합니다
KAKAO_REDIRECT_URI=

# [필수] Cron / 관리자 라우트 보호. 임의의 긴 랜덤 문자열
# Vercel Cron 은 이 값을 Authorization: Bearer 헤더로 자동 전송합니다.
CRON_SECRET=

# 카카오 메시지에 넣을 대시보드 주소 (비우면 Vercel 배포 URL 자동 사용)
NEXT_PUBLIC_APP_URL=
